generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_DATABASE_URL")
}

model InternalUsers {
  id String @id @map("_id") @db.ObjectId @default(auto())
  email String @unique
  password String
  createdAt DateTime? @default(now())
  role String
  name String
  tasks Task[]
}

model Task {
  id String @id @map("_id") @db.ObjectId @default(auto())
  task_info String 
  userId String
  user InternalUsers @relation(fields : [userId],references : [id])
  createdAt DateTime @default(now())
  status String @default("Received")
  sendedByRole String
  sendedByName String
}